{
  "skipWebFetchPreflight": true,
  "skillListingBudgetFraction": 0.03,
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(cat *)",
      "Bash(which *)",
      "Bash(python3 scripts/capability_lookup.py *)",
      "Bash(python3 scripts/evidence_scout/provider_doctor.py *)",
      "Bash(python3 scripts/validate_apis/run_all.py)",
      "Bash(python3 .claude/hooks/*.py)",
      "Bash(python3 -c *)",
      "Bash(python3 -m py_compile *)",
      "Bash(npm list *)",
      "Bash(npx --version)",
      "Bash(echo *)",
      "Bash(date)",
      "Bash(pwd)",
      "Bash(uname *)",
      "Bash(whoami)",
      "Bash(mkdir *)",
      "Read(**/*.md)",
      "Read(**/*.json)",
      "Read(**/*.py)",
      "Read(**/*.sh)",
      "Read(**/*.txt)",
      "Read(**/*.toml)",
      "Read(**/*.yml)",
      "Read(**/*.yaml)",
      "Read(**/*.cfg)",
      "Read(**/*.ini)",
      "Read(**/*.schema)",
      "Read(**/*.example)",
      "Bash(python3 scripts/route_workflow.py *)",
      "Bash(python3 scripts/validate_skill_routes.py)",
      "Bash(python3 scripts/run_evals.py *)",
      "Bash(python3 -m pytest *)",
      "Bash(bash scripts/validate_setup.sh)",
      "Bash(python3 scripts/case_economics.py *)",
      "Bash(python3 scripts/strategy_review.py *)",
      "Bash(python3 scripts/serper_fetch.py *)",
      "Bash(python3 scripts/evidence_scout/collect.py *)",
      "Bash(python3 scripts/evidence_scout/discover_market_problems.py *)",
      "Bash(python3 scripts/evidence_scout/plan_customer_feedback.py *)",
      "Bash(python3 scripts/evidence_scout/build_interview_kit.py *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*secret*)",
      "Bash(*MARKETING_APPROVAL_PIN*)",
      "Bash(*MARKETING_ALLOWED_SIGNERS*)",
      "Bash(*ssh-keygen*-Y sign*)",
      "Write(**/*.approval.json)",
      "Edit(**/*.approval.json)",
      "Write(**/receipts/**)",
      "Edit(**/receipts/**)",
      "Write(~/.config/business-strategist/**)",
      "Edit(~/.config/business-strategist/**)",
      "mcp__search-console-mcp__sites_manage",
      "mcp__search-console-mcp__sitemaps_submit",
      "mcp__search-console-mcp__sitemaps_delete",
      "mcp__search-console-mcp__indexing_submit",
      "mcp__search-console-mcp__accounts_manage",
      "mcp__search-console-mcp__adsense_accounts",
      "mcp__search-console-mcp__adsense_report",
      "mcp__search-console-mcp__adsense_payments_alerts",
      "mcp__meta-ads__ads_create_campaign",
      "mcp__meta-ads__ads_create_ad_set",
      "mcp__meta-ads__ads_create_ad",
      "mcp__meta-ads__ads_update_entity",
      "mcp__meta-ads__ads_activate_entity",
      "mcp__meta-ads__ads_create_creative",
      "mcp__meta-ads__ads_boost_ig_post",
      "mcp__meta-ads__ads_create_custom_audience",
      "mcp__meta-ads__ads_update_custom_audience",
      "mcp__meta-ads__ads_update_custom_audience_users",
      "mcp__meta-ads__ads_delete_custom_audience",
      "mcp__meta-ads__ads_catalog_create",
      "mcp__meta-ads__ads_catalog_update_catalog",
      "mcp__meta-ads__ads_catalog_product_create",
      "mcp__meta-ads__ads_catalog_update_product",
      "mcp__meta-ads__ads_catalog_delete_product",
      "mcp__meta-ads__ads_catalog_create_product_set",
      "mcp__meta-ads__ads_catalog_update_product_set",
      "mcp__meta-ads__ads_catalog_product_set_delete",
      "mcp__meta-ads__ads_catalog_create_product_feed",
      "mcp__meta-ads__ads_catalog_update_product_feed",
      "mcp__meta-ads__ads_catalog_create_product_feed_upload_session",
      "mcp__meta-ads__ads_catalog_product_feed_delete",
      "mcp__meta-ads__ads_catalog_create_feed_rule",
      "mcp__meta-ads__ads_catalog_product_feed_delete_rule",
      "mcp__meta-ads__ads_catalog_event_source_connect",
      "mcp__meta-ads__ads_catalog_event_source_disconnect",
      "mcp__meta-ads__ads_pixel_event_create",
      "mcp__meta-ads__ads_pixel_event_update",
      "mcp__meta-ads__ads_pixel_event_delete",
      "mcp__meta-ads__ads_pixel_parameter_create",
      "mcp__meta-ads__ads_pixel_parameter_update",
      "mcp__meta-ads__ads_pixel_parameter_delete",
      "mcp__meta-ads__ads_experiment_abtest_create_test",
      "mcp__meta-ads__ads_experiment_abtest_update_test",
      "mcp__meta-ads__ads_experiment_lift_create_test",
      "mcp__meta-ads__*create*",
      "mcp__meta-ads__*update*",
      "mcp__meta-ads__*delete*",
      "mcp__meta-ads__*activate*",
      "mcp__meta-ads__*boost*",
      "mcp__meta-ads__*connect*",
      "mcp__postiz__schedulePostTool",
      "mcp__postiz__postSettingsTool",
      "mcp__postiz__triggerTool",
      "mcp__postiz__uploadFromUrlTool",
      "mcp__postiz__generateImageTool",
      "mcp__postiz__generateVideoTool",
      "mcp__postiz__videoFunctionTool",
      "mcp__postiz__clippingTool"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/precompact.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/postcompact.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent_stop.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/enforce_skill_route.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/enforce_skill_route.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_delivery_check.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
