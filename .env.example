# Optional web-research providers. Leave blank until explicitly configured.
BRAVE_SEARCH_API_KEY=
FIRECRAWL_API_KEY_HGINVESTOR=
TRUSTPILOT_API_KEY=
GOOGLE_PLACES_API_KEY=

# Optional build-time image generation. Never expose as NEXT_PUBLIC_*.
FAL_AI_API_KEY=
# Separate Ed25519 functionary keys. Keep private keys with their signing stage;
# review/collection receive only the preceding stage's raw public key (all base64).
COMMUNITY_DISCOVERY_PRIVATE_KEY_B64=
COMMUNITY_DISCOVERY_PUBLIC_KEY_B64=
COMMUNITY_REVIEW_PRIVATE_KEY_B64=
COMMUNITY_REVIEW_PUBLIC_KEY_B64=

# Official statistics, studies and investor activity (also loaded from ~/.secrets)
PARSERSVC_API_KEY=
OPENALEX_API_KEY=
CENSUS_API_KEY=
BLS_API_KEY=
CROSSREF_MAILTO=

FRED_API_KEY=

COMPANIES_HOUSE_API_KEY=

# SEC public data: organization and real contact email; not an API key
SEC_USER_AGENT=
