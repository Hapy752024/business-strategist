{
  "purpose": "Where the founder funds a paid research provider or gets its key. Read by scripts/provider_health.py; keys are named, never stored here. URLs checked 2026-11-01.",
  "billing_kinds": {
    "prepaid": "prepaid credits or balance; top up when low",
    "subscription": "monthly plan with a quota; upgrade or wait for the reset",
    "pay_as_you_go": "billed on usage to a card on file",
    "free_key": "free, but needs a registered key or token",
    "free": "no key and no billing"
  },
  "providers": {
    "dataforseo": {
      "label": "DataForSEO (keyword volumes, backlinks)",
      "billing": "prepaid",
      "fund_url": "https://app.dataforseo.com/",
      "keys_url": "https://app.dataforseo.com/api-access",
      "env": [
        "DATAFORSEO_LOGIN",
        "DATAFORSEO_PASSWORD"
      ]
    },
    "dataforseo_google_trends": {
      "label": "DataForSEO Google Trends",
      "billing": "prepaid",
      "fund_url": "https://app.dataforseo.com/",
      "keys_url": "https://app.dataforseo.com/api-access",
      "env": [
        "DATAFORSEO_LOGIN",
        "DATAFORSEO_PASSWORD"
      ]
    },
