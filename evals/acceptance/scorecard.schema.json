{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Acceptance run scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario", "run", "checkpoints", "summary", "providers", "cost", "wall_time_s", "tokens", "hook_denials", "permission_denials", "writes_outside_eval", "friction", "honesty_notes"],
  "properties": {
    "schema_version": {"const": 1},
    "scenario": {"type": "string", "minLength": 1},
    "run": {
      "type": "object",
      "required": ["ref", "ref_sha", "eval_slug", "started_at", "finished_at", "rounds", "blocked_tools"],
      "properties": {
        "ref": {"type": "string"},
        "ref_sha": {"type": "string"},
        "eval_slug": {"type": "string"},
        "started_at": {"type": ["string", "null"]},
        "finished_at": {"type": ["string", "null"]},
        "rounds": {"type": "integer", "minimum": 0},
        "stop_reason": {"type": ["string", "null"]},
        "session_id": {"type": ["string", "null"]},
        "blocked_tools": {"type": "array", "items": {"type": "string"}}
      }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "title", "passed", "status", "proxy", "evidence_path", "detail"],
        "properties": {
          "id": {"type": "string"},
          "stage": {"type": "string"},
          "title": {"type": "string"},
          "passed": {"type": "boolean"},
          "status": {"enum": ["pass", "fail", "not_exercised"]},
          "proxy": {"type": "boolean"},
          "evidence_path": {"type": ["string", "null"]},
          "detail": {"type": "string"}
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed", "not_exercised", "proxy"],
      "properties": {
        "total": {"type": "integer"}, "passed": {"type": "integer"},
        "failed": {"type": "integer"}, "proxy": {"type": "integer"},
        "not_exercised": {"type": "array", "items": {"type": "string"}}
      }
    },
    "providers": {
      "type": "object",
      "required": ["attempted", "ok", "failed", "source"],
      "properties": {
        "attempted": {"type": "array", "items": {"type": "string"}},
        "ok": {"type": "array", "items": {"type": "string"}},
        "failed": {"type": "array", "items": {"type": "string"}},
        "source": {"type": "string"}
      }
    },
    "cost": {
      "type": "object",
      "required": ["model_usd", "model_budget_usd", "budget_usd", "provider_spend", "over_budget", "spend_enforced"],
      "properties": {
        "model_usd": {"type": "number"},
        "model_budget_usd": {"type": ["number", "null"]},
        "budget_usd": {"type": ["number", "null"]},
        "provider_spend": {
          "type": "object",
          "required": ["apify_usd", "dataforseo_usd", "serpapi_searches", "serpapi_usd", "measured_usd", "complete", "notes"],
          "properties": {
            "apify_usd": {"type": ["number", "null"]},
            "dataforseo_usd": {"type": ["number", "null"]},
            "serpapi_searches": {"type": ["number", "null"]},
            "serpapi_usd": {"type": ["number", "null"]},
            "measured_usd": {"type": "number"},
            "complete": {"type": "boolean"},
            "notes": {"type": "string"}
          }
        },
        "over_budget": {"type": ["boolean", "null"]},
        "spend_enforced": {"const": false}
      }
    },
    "wall_time_s": {"type": ["number", "null"]},
    "tokens": {
      "type": "object",
      "required": ["input", "output", "cache_creation", "cache_read"],
      "properties": {
        "input": {"type": "integer"}, "output": {"type": "integer"},
        "cache_creation": {"type": "integer"}, "cache_read": {"type": "integer"}
      }
    },
    "hook_denials": {
      "type": "object",
      "required": ["count", "by_tool", "events"],
      "properties": {
        "count": {"type": "integer"},
        "by_tool": {"type": "object", "additionalProperties": {"type": "integer"}},
        "events": {"type": "array", "items": {"type": "object"}}
      }
    },
    "permission_denials": {"type": "integer"},
    "writes_outside_eval": {"type": "array", "items": {"type": "string"}},
    "friction": {"type": "string"},
    "honesty_notes": {"type": "array", "items": {"type": "string"}}
  }
}
