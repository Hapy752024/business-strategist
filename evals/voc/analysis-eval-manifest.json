{
  "schema_version": "1.0",
  "status": "design_only_packets_and_scores_pending",
  "purpose": "Development scaffold for comparative customer-evidence analysis; not a result or gold-label set.",
  "split_policy": "Keep connected study, source and incident groups in one split. Reclassify connected held-out material as development if used during tuning.",
  "criteria_version": "1",
  "critical_failures": [
    "fabricated or meaning-altered quotation",
    "supplier voice presented as customer proof",
    "unsupported payment or prevalence claim",
    "wrong-study attribution"
  ],
  "dimensions": [
    "source_fidelity",
    "consequential_episode_coverage",
    "explanatory_usefulness",
    "theme_boundaries",
    "counterexample_handling",
    "uncertainty",
    "decision_usefulness"
  ],
  "adoption_rule": "Unfrozen pending baseline and packet review. No analytical improvement claim is allowed from this scaffold.",
  "tasks": [
    {
      "id": "dev-discovery",
      "split": "development",
      "group": "synthetic-discovery-1",
      "case": "broad discovery with weakly specified customer problem",
      "packet": "packets/dev-discovery.json",
      "review_key": "packets/review-key/dev-discovery.json",
      "paired_examples": "packets/paired-examples/dev-discovery.json"
    },
    {
