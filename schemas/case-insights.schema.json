{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case-insights.schema.json",
  "title": "Reviewed case insights publication",
  "type": "object",
  "additionalProperties": false,
    "required": ["assessment_revision", "manifest_revision", "document", "source_bindings", "coverage", "question_coverage", "conflicts", "review", "impact", "scope_status"],
  "properties": {
    "assessment_revision": {"type": "integer", "minimum": 1},
    "manifest_revision": {"type": "integer", "minimum": 1},
    "document": {"type": "string", "minLength": 1},
    "impact": {"enum": ["presentation_only", "reviewed_findings"]},
    "scope_status": {"enum": ["progress", "complete"]},
    "pending_summary": {"type": "string", "minLength": 20},
    "publication_contract_version": {"const": 2},
    "publication_claims": {"type": "array", "items": {"oneOf": [
      {"type": "object", "additionalProperties": false,
       "required": ["id", "document", "claim_id", "evidence_id", "ledger_binding", "source_kind", "limitation"],
       "properties": {"id": {"type": "string"}, "document": {"const": "case_insights.md"},
         "claim_id": {"type": "string"}, "evidence_id": {"type": "string"},
         "ledger_binding": {"$ref": "#/$defs/binding"},
         "source_kind": {"enum": ["original", "secondary", "private"]}, "limitation": {"type": "string"}}},
      {"type": "object", "additionalProperties": false,
       "required": ["id", "document", "capture_binding", "capture_index", "supporting_passage", "source_kind", "limitation"],
       "properties": {"id": {"type": "string"}, "document": {"const": "case_insights.md"},
         "capture_binding": {"$ref": "#/$defs/binding"}, "capture_index": {"type": "integer", "minimum": 0},
         "numeric_claim_id": {"type": "string"},
         "supporting_passage": {"type": "string", "minLength": 12},
         "source_kind": {"enum": ["original", "secondary", "private"]}, "limitation": {"type": "string"}}}]}},
    "independent_review": {"$ref": "#/$defs/binding"},
    "comparison": {"type": "object", "additionalProperties": false,
      "required": ["summary", "principal_uncertainty", "next_action"],
      "properties": {"summary": {"type": "string", "minLength": 10},
        "principal_uncertainty": {"type": "string", "minLength": 10},
        "next_action": {"type": "string", "minLength": 10}}},
    "economics_input_digest": {"type": ["string", "null"]},
    "source_bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
    "numeric_claims": {"type": "array", "items": {"type": "object"}},
    "coverage": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["path", "digest", "disposition", "reason"],
      "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"type": ["string", "null"]},
        "disposition": {"enum": ["incorporated", "superseded", "duplicate", "no_material_finding", "out_of_scope", "pending"]},
        "reason": {"type": "string", "minLength": 15}, "section": {"type": "string"}, "replacement": {"type": "string"}}}},
    "question_coverage": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "section", "reason"],
      "properties": {"id": {"type": "string", "minLength": 1}, "section": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 15}}}},
    "conflicts": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["left", "right", "scope", "resolution", "rationale", "section"],
      "properties": {"left": {"type": "string"}, "right": {"type": "string"}, "scope": {"type": "string"},
        "resolution": {"enum": ["corrected", "scope_qualified", "historical_superseded", "unresolved_disclosed"]},
        "rationale": {"type": "string", "minLength": 20}, "section": {"type": "string"}}}},
    "review": {"type": "object", "additionalProperties": false,
      "required": ["reviewer_type", "review_mode", "summary", "checks", "rendered_digest", "inventory_digest", "outcome", "blocking_findings"],
      "properties": {"reviewer_type": {"enum": ["analyst", "independent_human", "model"]},
        "review_mode": {"enum": ["inline", "fresh_context", "independent_review"]},
        "summary": {"type": "string", "minLength": 20},
        "outcome": {"enum": ["pass", "revise"]},
        "blocking_findings": {"type": "array", "items": {"type": "string", "minLength": 20}},
        "checks": {"type": "object", "additionalProperties": false,
          "required": ["accuracy", "completeness", "contradictions", "clarity"],
          "properties": {"accuracy": {"$ref": "#/$defs/review_check"},
            "completeness": {"$ref": "#/$defs/review_check"},
            "contradictions": {"$ref": "#/$defs/review_check"},
            "clarity": {"$ref": "#/$defs/review_check"}}},
        "rendered_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "inventory_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
  },
  "allOf": [{"if": {"properties": {"scope_status": {"const": "progress"}}, "required": ["scope_status"]},
    "then": {"required": ["pending_summary"]}}],
  "$defs": {"review_check": {"type": "object", "additionalProperties": false,
    "required": ["status", "rationale"], "properties": {
      "status": {"enum": ["pass", "fail", "not_reviewed"]},
      "rationale": {"type": "string", "minLength": 20}}},
    "binding": {"type": "object", "additionalProperties": false,
    "required": ["path", "digest", "locator", "applicability"],
    "properties": {"path": {"type": "string", "minLength": 1},
      "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "locator": {"type": "string", "minLength": 1}, "applicability": {"type": "string", "minLength": 1}}}}
}
