{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "array",
  "items": {"type": "object", "required": ["url", "community_type", "verification_status", "sources", "lane_assessments", "content_digest", "exact_text_retained", "eligible_for_targeted_collection"],
    "properties": {
      "url": {"type": "string", "format": "uri"}, "community_type": {"enum": ["forum", "facebook_group", "facebook_entity_candidate"]},
      "verification_status": {"enum": ["indexed_candidate", "source_shape_verified"]}, "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "exact_text_retained": {"const": false}, "eligible_for_targeted_collection": {"const": false},
      "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["provider", "query_id", "query", "query_kind", "original_url", "query_seeds", "result_rank", "fetched_at", "http_status", "observation_scope", "country", "language", "content_digest", "collector_version"], "properties": {
        "provider": {"type": "string", "minLength": 1}, "query_id": {"type": "string"}, "query": {"type": "string"}, "query_kind": {"type": "string"}, "original_url": {"type": "string", "format": "uri"}, "query_seeds": {"type": "array", "items": {"type": "string"}}, "result_rank": {"type": ["integer", "null"]}, "fetched_at": {"type": "string", "format": "date-time"}, "http_status": {"type": ["integer", "null"]}, "observation_scope": {"const": "search_index_result"}, "country": {"type": "string", "minLength": 2}, "language": {"type": "string", "minLength": 2}, "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "collector_version": {"type": "string", "minLength": 1}
      }, "additionalProperties": true}},
      "lane_assessments": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["locale_id", "seed", "query_kind", "provider", "qualified", "community_type", "source_content_digest"], "properties": {"locale_id": {"type": "string", "minLength": 4}, "seed": {"type": "string"}, "query_kind": {"enum": ["forum", "facebook_group", "facebook_page"]}, "provider": {"type": "string", "minLength": 1}, "qualified": {"type": "boolean"}, "community_type": {"enum": ["forum", "facebook_group", "facebook_entity_candidate", "rejected"]}, "source_content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}}
    }, "additionalProperties": true}
}
