{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "evidenceDecision": {
      "type": "object",
      "required": ["status", "locator", "observed_at", "content_digest", "note"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "title": "Community review packet",
  "type": "object",
  "required": ["decisions", "known_misses", "query_adjustments"],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "status", "reason"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "status": {"enum": ["accepted", "rejected", "unresolved"]},
          "reason": {"type": "string", "minLength": 1},
          "reviewer": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "format": "date-time"},
          "valid_until": {"type": "string", "format": "date-time"},
          "candidate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "research_use": {"const": "internal"},
          "ownership_cluster": {"type": "string", "minLength": 1},
          "independence_status": {"enum": ["distinct_source", "shared_or_unknown", "not_independent"]},
          "verified_entity_type": {"enum": ["forum", "facebook_group", "facebook_page"]},
          "reviewed_locale_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 4}},
          "dimensions": {
            "type": "object",
            "required": ["community_shape", "target_member_presence", "customer_segment_fit", "geography_fit", "language_fit", "activity_status", "source_ownership", "recent_experience_route", "public_access"],
            "properties": {
              "community_shape": {"allOf": [{"$ref": "#/$defs/evidenceDecision"}, {"properties": {"status": {"const": "verified"}}}]},
              "target_member_presence": {"allOf": [{"$ref": "#/$defs/evidenceDecision"}, {"properties": {"status": {"const": "evidenced"}}}]},
              "customer_segment_fit": {"allOf": [{"$ref": "#/$defs/evidenceDecision"}, {"properties": {"status": {"const": "matched"}}}]},
              "geography_fit": {"allOf": [{"$ref": "#/$defs/evidenceDecision"}, {"properties": {"status": {"const": "matched"}}}]},
              "language_fit": {"allOf": [{"$ref": "#/$defs/evidenceDecision"}, {"properties": {"status": {"const": "matched"}}}]},
              "activity_status": {"allOf": [{"$ref": "#/$defs/evidenceDecision"}, {"properties": {"status": {"const": "active"}}}]},
              "source_ownership": {"allOf": [{"$ref": "#/$defs/evidenceDecision"}, {"properties": {"status": {"const": "peer_community"}}}]},
              "recent_experience_route": {"allOf": [{"$ref": "#/$defs/evidenceDecision"}, {"properties": {"status": {"const": "evidenced"}}}]},
              "public_access": {"allOf": [{"$ref": "#/$defs/evidenceDecision"}, {"properties": {"status": {"enum": ["public", "legitimate_member_access"]}}}]}
            },
            "additionalProperties": false
          },
          "access": {
            "type": "object",
            "required": ["method", "no_credential_or_technical_bypass"],
            "properties": {
              "method": {"enum": ["public_web", "paid_public_api", "user_supplied_legitimate_access"]},
              "no_credential_or_technical_bypass": {"const": true}
            },
            "additionalProperties": false
          }
        },
        "allOf": [{"if": {"properties": {"status": {"const": "accepted"}}, "required": ["status"]}, "then": {"required": ["reviewer", "reviewed_at", "valid_until", "candidate_digest", "research_use", "ownership_cluster", "independence_status", "verified_entity_type", "reviewed_locale_ids", "dimensions", "access"]}}],
        "additionalProperties": false
      }
    },
    "direct_rechecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_type", "schema_version", "recheck_id", "url", "locator", "final_url", "entity_type", "provider", "http_status", "observed_at", "status", "content_digest", "response_body_retained", "content_type", "body_size_bytes", "access_status", "entity_type_observed", "activity_status", "semantic_markers", "signature_algorithm", "key_id", "signature"],
        "properties": {"artifact_type": {"const": "community_direct_recheck"}, "schema_version": {"const": 2}, "recheck_id": {"type": "string", "format": "uuid"}, "url": {"type": "string", "format": "uri"}, "locator": {"type": "string", "format": "uri"}, "final_url": {"type": "string", "format": "uri"}, "entity_type": {"enum": ["forum", "facebook_group", "facebook_page"]}, "provider": {"const": "direct_http"}, "http_status": {"type": ["integer", "null"]}, "observed_at": {"type": "string", "format": "date-time"}, "status": {"enum": ["retrieved", "failed"]}, "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "response_body_retained": {"const": false}, "content_type": {"type": "string", "minLength": 1}, "body_size_bytes": {"type": "integer", "minimum": 0}, "access_status": {"enum": ["public_content", "not_verified_public"]}, "entity_type_observed": {"enum": ["forum", "facebook_group", "facebook_page", "unresolved"]}, "activity_status": {"enum": ["active_recent", "not_verified_active"]}, "semantic_markers": {"type": "array", "uniqueItems": true, "items": {"enum": ["login_or_challenge", "interaction", "recent_time"]}}, "signature_algorithm": {"const": "ed25519"}, "key_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "signature": {"type": "string", "minLength": 80}},
        "additionalProperties": false
      }
    },
    "known_misses": {
      "type": "array",
      "items": {"type": "object", "required": ["locale", "provider", "locator", "note"], "properties": {"locale": {"type": "string"}, "provider": {"type": "string"}, "locator": {"type": "string"}, "note": {"type": "string"}}, "additionalProperties": false}
    },
    "query_adjustments": {
      "type": "array",
      "items": {"type": "object", "required": ["locale", "provider", "change", "reason"], "properties": {"locale": {"type": "string"}, "provider": {"type": "string"}, "change": {"type": "string"}, "reason": {"type": "string"}}, "additionalProperties": false}
    }
  },
  "additionalProperties": false
}
