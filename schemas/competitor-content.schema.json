{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Competitor and similar-company content coverage",
  "description": "Input to keyword-map merge. Similar companies and capability references abroad are analogs, never market evidence; entity_type keeps that distinction through the merge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "questions",
          "refs"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "pattern": "\\S"
          },
          "cluster_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "entity": {
            "type": "string",
            "minLength": 1
          },
          "entity_type": {
            "enum": [
              "competitor",
              "similar_company",
              "capability_reference"
            ]
          },
          "coverage": {
            "enum": [
              "covered_well",
              "covered_thin",
              "uncovered"
            ]
          }
        }
      }
    }
  }
}
