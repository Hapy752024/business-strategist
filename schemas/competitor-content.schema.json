{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Competitor and similar-company content coverage",
  "description": "Input to keyword-map merge. Similar companies and capability references abroad are analogs, never market evidence; entity_type keeps that distinction through the merge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string"
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "heuristics": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "cluster_summary": {
      "type": "array",
      "description": "Per-cluster reading. Only competitor rows set market_competitor_coverage; similar companies and capability references appear under inspiration only.",
      "items": {
        "type": "object",
        "required": [
          "cluster_id",
          "topic",
          "by_entity_type",
          "market_competitor_coverage",
          "interpretation",
          "inspiration"
        ],
        "properties": {
          "cluster_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "topic": {
            "type": "string"
          },
          "by_entity_type": {
            "type": "object"
          },
          "market_competitor_coverage": {
            "type": "boolean"
          },
          "interpretation": {
            "enum": [
              "covered_by_market_competitors",
              "quality_gap_hypothesis",
              "demand_question",
              "no_market_competitor_inventoried"
            ]
          },
          "inspiration": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "entity",
                "entity_type"
              ],
              "properties": {
                "entity_type": {
                  "enum": [
                    "similar_company",
                    "capability_reference"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "firecrawl_calls": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "skipped_entities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "questions",
          "refs"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "pattern": "\\S"
          },
          "cluster_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "entity": {
            "type": "string",
            "minLength": 1
          },
          "entity_type": {
            "enum": [
              "competitor",
              "similar_company",
              "capability_reference"
            ]
          },
          "coverage": {
            "enum": [
              "covered_well",
              "covered_thin",
              "uncovered"
            ]
          }
        },
        "dependentRequired": {
          "entity": [
            "entity_type"
          ]
        }
      }
    }
  }
}
