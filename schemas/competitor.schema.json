{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "competitor.schema.json",
  "title": "Competitor",
  "description": "Legacy-compatible candidate record. New workflows should use entity-landscape.schema.json lane fields.",
  "type": "object",
  "required": ["name", "url", "competitor_type_hint", "first_seen_at"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "url": { "oneOf": [{ "type": "string", "format": "uri" }, { "const": "" }] },
    "description": { "type": "string" },
    "classification": {
      "type": "string",
      "enum": ["direct", "indirect", "substitute", "future_threat", "false_positive", "blog", "directory", "marketplace", "agency", "review_site"]
    },
    "classification_reason": { "type": "string" },
    "competitor_type_hint": { "type": "string" },
    "first_seen_at": { "type": "string", "format": "date-time" },
    "lane_observations": { "type": "array", "items": { "enum": ["competitive_market", "similar_company", "capability_reference"] } },
    "primary_lane": { "type": "string", "enum": ["competitive_market", "similar_company", "capability_reference", "excluded", "uncertain"] },
    "competitive_role": { "type": "string", "enum": ["direct", "indirect", "substitute", "future_threat", "none", "unknown"] },
    "inspiration_roles": { "type": "array", "items": { "type": "string" } },
    "offer_job_overlap": { "type": "string", "enum": ["strong", "partial", "none", "unknown"] },
    "target_segment_overlap": { "type": "string", "enum": ["strong", "partial", "none", "unknown"] },
    "buyer_overlap": { "type": "string", "enum": ["strong", "partial", "none", "unknown"] },
    "geography_overlap": { "type": "string", "enum": ["strong", "partial", "none", "unknown"] },
    "price_tier_overlap": { "type": "string", "enum": ["strong", "partial", "none", "unknown"] },
    "purchase_substitutability": { "type": "string", "enum": ["strong", "partial", "none", "unknown"] },
    "verification_status": { "type": "string", "enum": ["verified", "likely", "uncertain", "excluded"] },
    "segment_fit": { "type": "string", "enum": ["strong", "partial", "weak", "unknown"] },
    "job_fit": { "type": "string", "enum": ["strong", "partial", "weak", "unknown"] },
    "key_success_factor_gaps": { "type": "array", "items": { "type": "string" } },
    "evidence_quality": { "type": "string", "enum": ["strong", "medium", "weak", "unverified"] },
    "discovered_at": { "type": "string", "format": "date-time" },
    "source_urls": {
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    }
  }
}
