{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "customer-voc-synthesis.schema.json",
  "type": "object",
  "required": ["topic_led_evidence_ids", "entity_led_evidence_ids", "customer_needs", "solution_requirements"],
  "properties": {
    "schema_version": {"enum": [1, 2, 3]},
    "topic": {"type": "string", "minLength": 1},
    "study_id": {"type": "string", "minLength": 1},
    "research_design_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "question_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "candidate_support": {"type": "array", "items": {"type": "object", "required": ["candidate_id", "statement", "question_ids", "u_ids", "claim_ids"], "properties": {"candidate_id": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "question_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "u_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}}},
    "report_review": {"type": "object", "required": ["report_sha256", "claim_ids", "reviewer_type", "review_mode", "omitted_claims_checked", "rationale"], "properties": {"report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "reviewer_type": {"enum": ["analyst", "independent_human", "model"]}, "review_mode": {"enum": ["inline", "fresh_context", "independent_review"]}, "omitted_claims_checked": {"const": true}, "rationale": {"type": "string", "minLength": 1}}},
    "status": {"enum": ["supported", "scoped", "provisional", "insufficient_evidence"]},
    "codebook": {"type": "object"},
    "segment_comparisons": {"type": "array", "items": {"type": "object", "required": ["id", "segment_a", "segment_b", "inclusion_exclusion", "episode_ids", "role_trigger_alternative_consequence", "contrary_evidence_ids", "unknowns", "split_merge_rationale", "action_difference"], "properties": {"id": {"type": "string", "minLength": 1}, "segment_a": {"type": "string", "minLength": 1}, "segment_b": {"type": "string", "minLength": 1}, "inclusion_exclusion": {"type": "string", "minLength": 1}, "episode_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "role_trigger_alternative_consequence": {"type": "string", "minLength": 1}, "contrary_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "unknowns": {"type": "string", "minLength": 1}, "split_merge_rationale": {"type": "string", "minLength": 1}, "action_difference": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "next_investigations": {"type": "array", "items": {"type": "object"}},
    "topic_led_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "entity_led_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "customer_needs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "outcome", "evidence_ids", "perspectives", "attribution"],
        "properties": {
          "id": {"type": "string", "pattern": "^U[0-9]+$"},
          "question_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "outcome": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "perspectives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["customer", "former_customer", "prospective_user", "nonadopter"]}},
          "attribution": {"enum": ["customer_stated", "analyst_inferred", "unknown"]}
        }
      }
    },
    "solution_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "condition_or_capability", "evidence_ids", "perspectives", "linked_u_ids", "operational_root_unknown", "attribution"],
        "properties": {
          "id": {"type": "string", "pattern": "^R[0-9]+$"},
          "question_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "condition_or_capability": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "perspectives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["customer", "former_customer", "prospective_user", "nonadopter"]}},
          "linked_u_ids": {"type": "array", "items": {"type": "string", "pattern": "^U[0-9]+$"}},
          "operational_root_unknown": {"type": "boolean"},
          "attribution": {"enum": ["customer_stated", "analyst_inferred", "unknown"]}
        },
        "anyOf": [
          {"properties": {"linked_u_ids": {"minItems": 1}}},
          {"properties": {"operational_root_unknown": {"const": true}}}
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 3}}, "required": ["schema_version"]},
      "then": {
        "required": ["topic", "study_id", "research_design_digest", "question_ids", "report_review", "candidate_support"],
        "properties": {
          "customer_needs": {"items": {"required": ["question_ids", "claim_ids"]}},
          "solution_requirements": {"items": {"required": ["question_ids", "claim_ids"]}}
        }
      }
    }
  ]
}
