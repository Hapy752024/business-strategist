{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-memo-scores.schema.json",
  "title": "Decision memo scores (generated summary of reviewed case artifacts)",
  "type": "object",
  "required": ["schema_version", "generated_view", "factors", "total", "verdict", "verdict_vocabulary", "riskiest_assumption", "next_tests", "kill_criteria", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_view": {"const": true},
    "factors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pain", "buyer", "reachability", "economics", "competition"],
      "properties": {
        "pain": {"$ref": "#/$defs/factor"}, "buyer": {"$ref": "#/$defs/factor"},
        "reachability": {"$ref": "#/$defs/factor"}, "economics": {"$ref": "#/$defs/factor"},
        "competition": {"$ref": "#/$defs/factor"}
      }
    },
    "total": {
      "type": "object",
      "required": ["score", "method", "caps_applied"],
      "properties": {"score": {"type": "number", "minimum": 0, "maximum": 100}, "caps_applied": {"type": "array", "items": {"type": "string"}}}
    },
    "verdict": {"enum": ["insufficient_evidence", "test", "commit", "pivot", "stop"]},
    "verdict_vocabulary": {"const": "strategy-plan.schema.json#/properties/verdict"},
    "riskiest_assumption": {
      "type": "object",
      "required": ["factor", "statement", "score", "test"],
      "properties": {"factor": {"$ref": "#/$defs/factor_name"}, "test": {"$ref": "#/$defs/test"}}
    },
    "next_tests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/test"}},
    "kill_criteria": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["factor", "threshold", "action"], "properties": {"factor": {"$ref": "#/$defs/factor_name"}, "threshold": {"type": "string", "minLength": 1}}}
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "factor_name": {"enum": ["pain", "buyer", "reachability", "economics", "competition"]},
    "factor": {
      "type": "object",
      "required": ["score", "band", "basis", "excluded_quarantined"],
      "properties": {
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "band": {"enum": ["unknown", "0-20", "21-50", "51-80", "81-100"]},
        "basis": {"type": "array", "items": {"type": "object", "required": ["artifact", "field"], "properties": {"artifact": {"type": "string", "minLength": 1}, "field": {"type": "string", "minLength": 1}}}},
        "excluded_quarantined": {"type": "array", "items": {"type": "string"}}
      }
    },
    "test": {
      "type": "object",
      "required": ["factor", "assumption", "action", "max_days", "cost_cap", "currency", "kill_threshold"],
      "properties": {
        "factor": {"$ref": "#/$defs/factor_name"},
        "max_days": {"type": "integer", "minimum": 1, "maximum": 14},
        "cost_cap": {"type": "number", "minimum": 0},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}
      }
    }
  }
}
