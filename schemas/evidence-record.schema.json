{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-record.schema.json",
  "title": "Evidence Record",
  "description": "Normalized evidence record from any provider source.",
  "type": "object",
  "required": ["source", "retrieved_at", "evidence_type", "text", "strength"],
  "properties": {
    "schema_version": {"type": "string"},
    "evidence_id": {"type": "string", "minLength": 1},
    "published_at": {"type": "string", "format": "date-time"},
    "canonical_url": {"type": "string", "format": "uri"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "independence_key": {"type": "string", "minLength": 1},
    "duplicate_cluster_id": {"type": "string"},
    "signal_quality": {"type": "object", "properties": {"directness": {"type": "string"}, "specificity": {"type": "string"}, "authenticity": {"type": "string"}, "recency": {"type": "string"}, "relevance": {"type": "string"}}},
    "source": {
      "type": "string",
      "enum": ["reddit", "youtube", "youtube_comment", "youtube_transcript", "google_trends", "google_autocomplete", "forum", "web_search", "x", "xai_x_search", "tiktok", "instagram", "threads", "facebook", "app_store", "app_review", "itunes_reviews", "amazon", "news", "web", "brave_search", "firecrawl", "crawl4ai", "markitdown", "scrapling", "hn", "github", "bilibili", "bilibili_comment", "v2ex", "zhihu", "weibo", "douban", "tieba", "xiaohongshu"]
    },
    "source_url": { "type": "string", "format": "uri" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "query": { "type": "string" },
    "customer_segment": { "type": "string" },
    "hypothesis_id": { "type": "string" },
    "evidence_type": {
      "type": "string",
      "enum": ["pain", "workaround", "switching_cost", "spend", "search_demand", "counter_evidence", "community", "competitor_gap", "decision_uncertainty", "irrelevant"]
    },
    "text": { "type": "string", "minLength": 1 },
    "verbatim_quote": { "type": "string" },
    "author_context": { "type": "string" },
    "source_record_id": {"type": "string", "minLength": 1},
    "source_role": {"enum": ["customer_statement", "customer_review", "creator_statement", "search_suggestion", "search_result", "competitor_context", "editorial_context", "community_context", "discovery_only"]},
    "retrieval_backend": {"type": "string"},
    "query_language": {"type": "string"},
    "source_language": {"type": "string"},
    "output_language": {"type": "string"},
    "engagement": {
      "type": "object",
      "properties": {
        "upvotes": { "type": ["integer", "null"] },
        "comments": { "type": ["integer", "null"] },
        "views": { "type": ["integer", "null"] },
        "likes": { "type": ["integer", "null"] }
      }
    },
    "strength": {
      "type": "string",
      "enum": ["strong", "medium", "weak", "negative", "irrelevant"]
    },
    "confidence_notes": { "type": "string" }
  }
}
