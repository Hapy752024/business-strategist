{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "falsification-verdicts.schema.json",
  "title": "Claim Falsification Verdicts (untrusted agent output)",
  "description": "Returned by the claim-falsifier agent. 'survived' means only that the stated search budget found no disconfirming evidence; it never confirms or upgrades a claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "search_budget_per_claim", "verdicts"],
  "properties": {
    "schema_version": {"const": 1},
    "search_budget_per_claim": {"type": "integer", "minimum": 1, "maximum": 10},
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "verdict", "evidence", "searches_run", "rationale"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["falsified", "weakened", "survived", "inconclusive"]},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "date", "quote"],
              "properties": {
                "url": {"type": "string", "pattern": "^https?://[^\\s]+$", "maxLength": 2048},
                "date": {"type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
                "quote": {"type": "string", "minLength": 1, "maxLength": 300}
              }
            }
          },
          "searches_run": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 1200},
          "proposed_confidence": {"enum": ["unresolved", "low", "medium", "high"]}
        },
        "allOf": [
          {
            "if": {"properties": {"verdict": {"enum": ["falsified", "weakened"]}}},
            "then": {"properties": {"evidence": {"minItems": 1}}}
          }
        ]
      }
    }
  }
}
