{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "rows": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "locale": {
            "type": "string",
            "minLength": 1
          },
          "primary_term": {
            "type": "string",
            "minLength": 1
          },
          "secondary_terms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "page_purpose": {
            "type": "string",
            "minLength": 1
          },
          "target_url": {
            "type": "string",
            "minLength": 1
          },
          "existing_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "decision": {
            "enum": [
              "retain",
              "improve",
              "create",
              "consolidate",
              "retire"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "checked_at": {
            "type": "string",
            "format": "date"
          },
          "missing_information": {
            "type": "string"
          },
          "original_contribution": {
            "type": "string",
            "minLength": 1
          },
          "internal_links": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "conversion_bridge": {
            "type": "string",
            "minLength": 1
          },
          "priority_rationale": {
            "type": "string",
            "minLength": 1
          },
          "assignment_exception": {
            "type": "string"
          },
          "redirect_to": {
            "type": [
              "string",
              "null"
            ]
          },
          "volume": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "volume_provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "volume_checked_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "cpc": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "competition": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "description": "Google Ads competition index 0-100 (paid SERP only)"
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "fetched_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_refetch": {
            "type": [
              "string",
              "null"
            ]
          },
          "traffic_potential": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Estimated monthly organic traffic of the current #1 page for the primary term (provider estimate); beats raw volume"
          },
          "business_potential": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 3,
            "description": "0 irrelevant, 1 informational and hard to pitch, 2 'best X' comparison, 3 ready to buy"
          },
          "serp_shape": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "content_type",
              "format"
            ],
            "properties": {
              "content_type": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "type": "string",
                "minLength": 1
              },
              "angle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "observed_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              }
            },
            "description": "Dominant content type, format and angle of the current top results; a guide cannot rank where category/product pages dominate"
          },
          "difficulty": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "intent_mismatch_in_top": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "links_within_reach": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "authority_in_ballpark": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "topical_authority_comparable": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "better_offer_possible": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "description": "Yes/no signals compared with the current top pages; more yes, more winnable"
          },
          "ai_answerable": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "True when an AI answer settles the query without a click (observed, dated); then the goal is a mention in the answer, not the click"
          },
          "ai_answer_observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        },
        "required": [
          "id",
          "locale",
          "primary_term",
          "intent",
          "page_purpose",
          "target_url",
          "existing_url",
          "decision",
          "evidence_refs",
          "checked_at",
          "missing_information",
          "original_contribution",
          "internal_links",
          "conversion_bridge",
          "priority_rationale"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "rows"
  ]
}
