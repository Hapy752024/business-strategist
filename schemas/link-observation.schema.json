{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "final_url": {
      "type": "string",
      "minLength": 1
    },
    "target_url": {
      "type": "string",
      "minLength": 1
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "present",
        "absent",
        "access_limited",
        "fetch_error"
      ]
    },
    "http_status": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 100,
      "maximum": 599
    },
    "anchors": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "href": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "rel": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "href",
          "text",
          "rel"
        ]
      }
    },
    "redirects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "capture_method": {
      "enum": [
        "http",
        "rendered"
      ]
    },
    "parser_version": {
      "const": "html-anchors-v1"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "source_url",
    "final_url",
    "target_url",
    "checked_at",
    "outcome",
    "http_status",
    "anchors",
    "redirects",
    "capture",
    "capture_method",
    "parser_version",
    "reason"
  ]
}
