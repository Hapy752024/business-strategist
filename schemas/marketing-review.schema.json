{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "marketing-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "campaign_id",
    "packet_id",
    "decision",
    "diagnosis",
    "limitations",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "packet_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision": {
      "enum": [
        "continue",
        "change",
        "stop",
        "collect_more_data"
      ]
    },
    "diagnosis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "objective",
          "actor",
          "next_step",
          "completion_criterion",
          "reason",
          "estimated_minutes",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "actor": {
            "enum": [
              "agent",
              "owner"
            ]
          },
          "next_step": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "completion_criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "estimated_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 240
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        }
      }
    }
  }
}
