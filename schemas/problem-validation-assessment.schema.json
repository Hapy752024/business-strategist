{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem-validation-assessment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "intent", "case_id", "assessment_revision", "target_segment", "scope", "study_id", "research_design_digest", "section_inputs", "voc_pack_path", "voc_pack_hashes", "finding_ids", "claim_ids", "review"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["supported", "scoped", "insufficient_evidence"]},
    "intent": {"enum": ["customer_problem", "idea_validation"]},
    "case_id": {"type": "string"},
    "assessment_revision": {"type": "integer", "minimum": 1},
    "target_segment": {"type": "string", "minLength": 1},
    "scope": {"type": "object", "required": ["geography", "limits"], "properties": {"geography": {"type": "string", "minLength": 1}, "limits": {"type": "string", "minLength": 1}}},
    "study_id": {"type": "string", "minLength": 1},
    "research_design_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "section_inputs": {"type": "object", "required": ["customer_segments", "customer_journey", "pain_points"], "properties": {"customer_segments": {"$ref": "#/$defs/input"}, "customer_journey": {"$ref": "#/$defs/input"}, "pain_points": {"$ref": "#/$defs/input"}}},
    "voc_pack_path": {"type": "string", "minLength": 1},
    "voc_pack_hashes": {"type": "object", "required": ["evidence.jsonl", "source-review.json", "customer-feedback-coverage.json", "customer-voc-synthesis.json", "claim-ledger.json", "customer-feedback-source-plan.json"], "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "finding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^U[0-9]+$"}},
    "claim_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "review": {"type": "object", "required": ["reviewer_id", "reviewer_type", "review_mode", "reviewed_at", "rationale"], "properties": {"reviewer_id": {"type": "string", "minLength": 1}, "reviewer_type": {"enum": ["independent_human", "model"]}, "review_mode": {"enum": ["fresh_context", "independent_review"]}, "reviewed_at": {"type": "string", "format": "date-time"}, "rationale": {"type": "string", "minLength": 1}}}
  },
  "$defs": {"input": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
}
