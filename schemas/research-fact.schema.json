{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-fact.schema.json",
  "title": "Captured non-customer research fact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "fact_kind",
    "source",
    "source_record_id",
    "source_url",
    "publisher",
    "source_role",
    "retrieved_at",
    "reference_period",
    "geography",
    "population",
    "original_language",
    "capture_path",
    "content_sha256",
    "locator",
    "observation",
    "text",
    "review_status",
    "uncertainty"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "fact_kind": {
      "enum": [
        "statistic",
        "study_metadata",
        "study_finding",
        "company_observation",
        "funding_observation"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_record_id": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "source_role": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "minLength": 1
    },
    "reference_period": {
      "type": "string",
      "minLength": 1
    },
    "geography": {
      "type": "string",
      "minLength": 1
    },
    "population": {
      "type": "string",
      "minLength": 1
    },
    "original_language": {
      "type": "string",
      "minLength": 1
    },
    "capture_path": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "observation": {
      "type": "object"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ]
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": "object",
      "required": [
        "reviewer",
        "reviewed_at",
        "fact_digest",
        "rationale"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "minLength": 1
        },
        "fact_digest": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "required": [
          "review"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "fact_kind": {
            "const": "statistic"
          }
        }
      },
      "then": {
        "properties": {
          "observation": {
            "required": [
              "metric",
              "period",
              "value",
              "unit",
              "currency",
              "scope"
            ],
            "properties": {
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
