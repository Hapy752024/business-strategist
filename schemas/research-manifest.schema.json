{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-manifest.schema.json",
  "title": "Research Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "topic",
    "topic_slug",
    "created_at",
    "updated_at",
    "current_stage",
    "stages",
    "events",
    "open_blockers",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "topic_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "current_stage": {
      "type": "string"
    },
    "gate_result": {
      "enum": [
        "pass",
        "fail",
        "conditional_pass",
        "not_run"
      ]
    },
    "blocked_reason": {
      "type": "string"
    },
    "next_action": {
      "type": "string"
    },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "$ref": "stage-checkpoint.schema.json"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ts",
          "event"
        ],
        "properties": {
          "ts": {
            "type": "string",
            "format": "date-time"
          },
          "event": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "open_blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manifest_revision": {
      "type": "integer",
      "minimum": 1
    },
    "research_assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "decision", "customer_segment", "locales", "parent_run", "capture_runs", "source_plan_path"],
      "properties": {
        "schema_version": {"enum": [1, 2]},
        "decision": {"type": "string", "minLength": 12},
        "customer_segment": {"type": "string", "minLength": 3},
        "locales": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z]{2}:[a-z]{2}$"}},
        "parent_run": {"type": "string", "minLength": 1},
        "capture_runs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_plan_path": {"type": "string", "minLength": 1},
        "studies": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["run_dir", "source_plan_path", "source_plan_sha256", "relation", "applicability"], "properties": {"run_dir": {"type": "string", "minLength": 1}, "source_plan_path": {"type": "string", "minLength": 1}, "source_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "relation": {"enum": ["target", "adjacent", "context"]}, "applicability": {"type": "string", "minLength": 20}}}},
        "capture_owners": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["capture_run", "study_run"], "properties": {"capture_run": {"type": "string", "minLength": 1}, "study_run": {"type": "string", "minLength": 1}}}},
        "coverage_cells": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["question", "locale", "frame", "study_run", "cell_id"], "properties": {"question": {"type": "string", "minLength": 12}, "locale": {"type": "string", "pattern": "^[A-Z]{2}:[a-z]{2}$"}, "frame": {"enum": ["topic_led_voc", "entity_led_feedback"]}, "study_run": {"type": "string", "minLength": 1}, "cell_id": {"type": "string", "minLength": 1}}}},
        "overlap_reviews": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["source_url", "study_runs", "disposition", "reviewer", "reason"], "properties": {"source_url": {"type": "string", "pattern": "^https?://"}, "study_runs": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "disposition": {"enum": ["same_incident", "distinct_interpretations"]}, "reviewer": {"type": "string", "minLength": 3}, "reason": {"type": "string", "minLength": 20}}}}
      },
      "allOf": [{"if": {"properties": {"schema_version": {"const": 2}}}, "then": {"required": ["studies", "capture_owners", "coverage_cells", "overlap_reviews"]}}, {"if": {"properties": {"schema_version": {"const": 1}}}, "then": {"not": {"anyOf": [{"required": ["studies"]}, {"required": ["capture_owners"]}, {"required": ["coverage_cells"]}, {"required": ["overlap_reviews"]}]}}}]
    },
    "coaching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known_answers",
        "unresolved_inputs",
        "pending_question"
      ],
      "properties": {
        "known_answers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "value",
              "provenance"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "provenance": {
                "enum": [
                  "user_confirmed",
                  "assumption",
                  "evidence"
                ]
              },
              "source": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "unresolved_inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pending_question": {
          "type": "string"
        },
        "decision_impact": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "research_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "question", "status"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "question": {"type": "string", "minLength": 1},
              "status": {"enum": ["open", "partial", "answered"]},
              "answer_binding": {"type": "object", "required": ["path", "digest", "locator", "applicability"],
                "additionalProperties": false,
                "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"type": "string", "minLength": 1},
                  "locator": {"type": "string", "minLength": 1}, "applicability": {"type": "string", "minLength": 1}}}
            }
          }
        }
      }
    },
    "insights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "path", "state"],
      "properties": {
        "contract_version": {"enum": [1, 2]},
        "path": {"const": "case_insights.md"},
        "state": {"enum": ["draft", "current", "update_pending"]},
        "document_digest": {"type": "string"},
        "inventory_digest": {"type": "string"},
        "review_path": {"type": "string"},
        "review_digest": {"type": "string"},
        "assessment_revision": {"type": "integer", "minimum": 1},
        "published_at": {"type": "string", "format": "date-time"},
        "scope_status": {"enum": ["progress", "complete"]},
        "pending_summary": {"type": ["string", "null"]}
      }
    },
    "case_id": {
      "type": "string"
    },
    "assessment_revision": {
      "type": "integer",
      "minimum": 1
    },
    "appraisal_contract_version": {"const": 2},
    "appraisal_publication_status": {"enum": ["progress", "final"]},
    "appraisal_review": {"type": "object"},
    "appraisal_reviewed_outputs": {"type": "array", "items": {"type": "string"}},
    "source_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "digest",
          "locator",
          "applicability"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "applicability": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "comparison": {
      "type": "object",
      "required": [
        "summary",
        "principal_uncertainty",
        "next_action",
        "assessment_revision"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "principal_uncertainty": {
          "type": "string",
          "minLength": 1
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "assessment_revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "document_bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "authored_digest",
          "economics_input_digest",
          "model_input_digest"
        ],
        "properties": {
          "authored_digest": {
            "type": "string"
          },
          "economics_input_digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "model_input_digest": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
