{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "search-journey-plan.schema.json",
  "title": "Customer search-journey SERP study plan",
  "description": "Extends the pain-query-plan row with journey stage, searcher role, search intent and seed origin. Brainstormed rows are hypotheses about what customers type, not observed queries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rows"],
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": "string", "pattern": "\\S"},
    "topic": {"type": "string"},
    "customer_segment": {"type": "string"},
    "known_competitors": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
    "notes": {"type": "string"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query_id", "query", "journey_stage", "searcher_role", "intent", "seed_origin", "locale", "language"],
        "properties": {
          "query_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
          "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
          "cluster_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
          "query": {"type": "string", "pattern": "\\S"},
          "journey_stage": {"enum": ["problem_aware", "solution_aware", "comparison", "purchase", "local", "post_purchase"]},
          "searcher_role": {"enum": ["user", "buyer", "influencer"]},
          "intent": {"enum": ["informational", "commercial", "transactional", "navigational"]},
          "seed_origin": {"enum": ["brainstorm", "autocomplete", "paa", "related_search", "customer_quote"]},
          "seed_locators": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "\\S"}},
          "locale": {"type": "string", "pattern": "^[a-z]{2,3}-[A-Z]{2}$", "description": "language-COUNTRY, e.g. de-DE; COUNTRY sets Google gl."},
          "language": {"type": "string", "pattern": "^[a-z]{2,3}$", "description": "Google hl."},
          "location": {"type": "string", "pattern": "\\S", "description": "Provider location string, e.g. Germany or Berlin,Germany."},
          "device": {"enum": ["desktop", "mobile", "tablet"]},
          "rationale": {"type": "string"},
          "question_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "\\S"}}
        },
        "allOf": [
          {
            "if": {"properties": {"seed_origin": {"enum": ["autocomplete", "paa", "related_search", "customer_quote"]}}, "required": ["seed_origin"]},
            "then": {"required": ["seed_locators"]}
          }
        ]
      }
    }
  }
}
