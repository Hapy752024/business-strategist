{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Social discussion topics",
  "description": "Input to keyword-map merge: what people discuss on social media. Discussion is self-selected and not demand proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "questions",
          "refs"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "pattern": "\\S"
          },
          "cluster_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "speaker_mix": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            },
            "description": "Share or count of speaker types, e.g. customers, suppliers, influencers"
          }
        }
      }
    }
  }
}
