{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Social discussion topics",
  "description": "Input to keyword-map merge: what people discuss on social media. Discussion is self-selected and not demand proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "questions",
          "refs"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "pattern": "\\S"
          },
          "cluster_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "speaker_mix": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            },
            "description": "Share or count of speaker types, e.g. customers, suppliers, influencers"
          },
          "topic_id": {
            "type": "string"
          },
          "cluster_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "search_check": {
            "enum": [
              "matched_search_cluster",
              "candidate_to_check_in_search"
            ]
          },
          "single_platform": {
            "type": "boolean"
          },
          "supplier_only": {
            "type": "boolean"
          },
          "record_count": {
            "type": "integer",
            "minimum": 1
          },
          "record_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "phrases": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": [
                "text",
                "record_id"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 120
                },
                "record_id": {
                  "type": "string"
                }
              }
            }
          },
          "engagement": {
            "type": "object",
            "description": "Per platform only; never compared or summed across platforms."
          },
          "formats": {
            "type": "object"
          },
          "first_seen": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_seen": {
            "type": [
              "string",
              "null"
            ]
          },
          "date_basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "label": {
            "type": "string"
          },
          "platform_counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          }
        }
      }
    },
    "generated_at": {
      "type": "string"
    },
    "method": {
      "type": "object"
    },
    "records_considered": {
      "type": "integer",
      "minimum": 0
    },
    "records_skipped": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "records_assigned": {
      "type": "integer",
      "minimum": 0
    },
    "records_unassigned": {
      "type": "integer",
      "minimum": 0
    }
  }
}
