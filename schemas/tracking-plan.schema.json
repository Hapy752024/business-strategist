{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tracking-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80},
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "trigger", "required_properties", "consent_category", "destinations", "owner", "required_for_launch"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_$.-]{0,99}$"},
          "trigger": {"type": "string", "minLength": 1, "maxLength": 500},
          "required_properties": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,99}$"}
          },
          "consent_category": {"enum": ["necessary", "analytics", "marketing"]},
          "consent_gated": {"type": "boolean", "description": "Event only fires after consent. Defaults to true unless the category is necessary."},
          "destinations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["ga4", "posthog", "meta_capi"]}
          },
          "owner": {"type": "string", "minLength": 1, "maxLength": 120},
          "required_for_launch": {"type": "boolean"}
        }
      }
    }
  }
}
