{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "website-manifest.schema.json",
  "title": "Website Build Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_revision", "updated_at", "website_id", "entry_mode", "stack", "preferences", "concept", "pages", "qa", "release", "next_action", "open_blockers"],
  "properties": {
    "schema_version": {"type": "string"},
    "manifest_revision": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "website_id": {"type": "string", "minLength": 1},
    "entry_mode": {"enum": ["standalone", "business_linked"]},
    "stack": {"type": "object", "additionalProperties": false, "required": ["next", "react", "node", "package_manager", "resolver_source", "resolved_at"], "properties": {"next": {"type": "string"}, "react": {"type": "string"}, "node": {"type": "string"}, "package_manager": {"type": "string"}, "lockfile": {"type": "string"}, "resolver_source": {"type": "string", "format": "uri"}, "resolved_at": {"type": "string", "format": "date-time"}}},
    "preferences": {"type": "string"},
    "brand_refs": {"type": "array", "items": {"type": "string"}},
    "concept": {"type": "object", "additionalProperties": false, "required": ["territories", "selected", "signature_device", "approval_status"], "properties": {"territories": {"type": "array", "items": {"type": "object"}}, "selected": {"type": "string"}, "signature_device": {"type": "string"}, "approval_status": {"enum": ["pending", "approved", "delegated"]}}},
    "pages": {"type": "array", "items": {"type": "object"}},
    "fal_assets": {"type": "array", "items": {"type": "object"}},
    "experiment": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["hypothesis", "changed_variable", "control", "treatment", "assignment", "audience", "allocation", "primary_metric", "guardrails", "start_rule", "stop_rule", "cleanup_owner", "status", "requires_approval"], "properties": {"hypothesis": {"type": "string", "minLength": 1}, "changed_variable": {"type": "string", "minLength": 1}, "control": {"type": "string"}, "treatment": {"type": "string"}, "assignment": {"type": "string"}, "audience": {"type": "string"}, "allocation": {"type": "object", "additionalProperties": false, "required": ["control", "treatment"], "properties": {"control": {"type": "integer", "minimum": 0, "maximum": 100}, "treatment": {"type": "integer", "minimum": 0, "maximum": 100}}}, "primary_metric": {"type": "string", "minLength": 1}, "guardrails": {"type": "array", "items": {"type": "string"}}, "start_rule": {"type": "string"}, "stop_rule": {"type": "string"}, "cleanup_owner": {"type": "string"}, "status": {"enum": ["not_started", "preview", "running", "stopped", "completed", "archived"]}, "requires_approval": {"const": true}}}]},
    "qa": {"type": "object", "additionalProperties": false, "required": ["build", "accessibility", "performance", "responsive", "visual_review"], "properties": {"build": {"enum": ["pending", "pass", "fail"]}, "accessibility": {"enum": ["pending", "pass", "fail"]}, "performance": {"enum": ["pending", "pass", "fail"]}, "responsive": {"enum": ["pending", "pass", "fail"]}, "visual_review": {"enum": ["pending", "pass", "fail"]}}},
    "release": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["local", "preview", "production", "rolled_back"]}, "github_repo": {"type": "string"}, "github_branch": {"type": "string"}, "vercel_project": {"type": "string"}, "environment": {"enum": ["local", "preview", "production"]}, "commit": {"type": "string", "pattern": "^[a-f0-9]{7,40}$"}, "preview_url": {"type": "string", "format": "uri"}, "production_url": {"type": "string", "format": "uri"}, "rollback_commit": {"type": "string", "pattern": "^[a-f0-9]{7,40}$"}, "recorded_at": {"type": "string", "format": "date-time"}}},
    "next_action": {"type": "string"},
    "open_blockers": {"type": "array", "items": {"type": "string"}}
  }
}
