    "pages": {"type": "array", "items": {"type": "object"}},
    "fal_assets": {"type": "array", "items": {"type": "object"}},
    "experiment": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["hypothesis", "changed_variable", "control", "treatment", "assignment", "audience", "allocation", "primary_metric", "guardrails", "start_rule", "stop_rule", "cleanup_owner", "status", "requires_approval"], "properties": {"hypothesis": {"type": "string", "minLength": 1}, "changed_variable": {"type": "string", "minLength": 1}, "control": {"type": "string"}, "treatment": {"type": "string"}, "assignment": {"type": "string"}, "audience": {"type": "string"}, "allocation": {"type": "object", "additionalProperties": false, "required": ["control", "treatment"], "properties": {"control": {"type": "integer", "minimum": 0, "maximum": 100}, "treatment": {"type": "integer", "minimum": 0, "maximum": 100}}}, "primary_metric": {"type": "string", "minLength": 1}, "guardrails": {"type": "array", "items": {"type": "string"}}, "start_rule": {"type": "string"}, "stop_rule": {"type": "string"}, "cleanup_owner": {"type": "string"}, "status": {"enum": ["not_started", "preview", "running", "stopped", "completed", "archived"]}, "requires_approval": {"const": true}}}]},
    "qa": {"type": "object", "additionalProperties": false, "required": ["build", "accessibility", "performance", "responsive", "visual_review"], "properties": {"build": {"enum": ["pending", "pass", "fail"]}, "accessibility": {"enum": ["pending", "pass", "fail"]}, "performance": {"enum": ["pending", "pass", "fail"]}, "responsive": {"enum": ["pending", "pass", "fail"]}, "visual_review": {"enum": ["pending", "pass", "fail"]}}},
    "launch": {"type": "object","additionalProperties": false,"required": ["version","commit","url","deployment_id","checks"],"properties": {"version": {"const": 1},"commit": {"type": "string"},"url": {"type": "string"},"deployment_id": {"type": "string"},"checks": {"type": "object","additionalProperties": false,"required": ["custom_404","meta_title","meta_description","above_fold_cta","favicon_integration","robots","https_enforcement","sitemap","open_graph","image_alt","mobile_breakpoints","sticky_mobile_cta","loading_states","form_errors","spam_protection","thank_you","privacy_policy","terms","cookie_consent","analytics","contact_address","compressed_images","seo_geo","broken_links","performance","browser_tests"],"properties": {"custom_404": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"meta_title": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"meta_description": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"above_fold_cta": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"favicon_integration": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"robots": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"https_enforcement": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"sitemap": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"open_graph": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"image_alt": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"mobile_breakpoints": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"sticky_mobile_cta": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"loading_states": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"form_errors": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"spam_protection": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"thank_you": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"privacy_policy": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"terms": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"cookie_consent": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"analytics": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail","not_requested"]},"evidence": {"type": "string"}}},"contact_address": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"compressed_images": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"seo_geo": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"broken_links": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"performance": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}},"browser_tests": {"type": "object","additionalProperties": false,"required": ["status","evidence"],"properties": {"status": {"enum": ["pending","pass","fail"]},"evidence": {"type": "string"}}}}}}},
    "release": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"enum": ["local", "preview", "production", "rolled_back"]}, "github_repo": {"type": "string"}, "github_branch": {"type": "string"}, "vercel_project": {"type": "string"}, "environment": {"enum": ["local", "preview", "production"]}, "commit": {"type": "string", "pattern": "^[a-f0-9]{7,40}$"}, "preview_url": {"type": "string", "format": "uri"}, "production_url": {"type": "string", "format": "uri"}, "rollback_commit": {"type": "string", "pattern": "^[a-f0-9]{7,40}$"}, "recorded_at": {"type": "string", "format": "date-time"}, "deployment_id": {"type": "string"}}},
    "next_action": {"type": "string"},
    "open_blockers": {"type": "array", "items": {"type": "string"}}
